    "C04": { "name": "整面浸染 Drenched", "summary": "The whole page is tinted with the seed; text and marks are deep shades of the same hue." },
    "C05": { "name": "深色控制台 Dark console", "summary": "Tinted near-black ground, luminous seed accent, for technical and night-time products." },
    "C06": { "name": "双色对话 Duotone", "summary": "Two deliberate hues share the page: the seed for action and a second hue for bands and data." },
    "C07": { "name": "自然大地 Earthy", "summary": "Warm, low-chroma earth neutrals and a muted seed; natural materials, calm." },
    "C08": { "name": "明快撞色 Pop", "summary": "White ground, saturated seed plus one contrasting pop hue; energetic campaigns and social." },
    "C09": { "name": "数据报告 Report", "summary": "Cool neutral paper, one ink blue, one alert red; color marks only the story in the data." },
    "C10": { "name": "夜读编辑 Dark editorial", "summary": "Deep warm dark ground with cream text and a glowing seed accent; evening, editorial, premium." }
  },
