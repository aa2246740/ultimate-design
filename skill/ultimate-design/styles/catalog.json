  "color": {
    "C01": { "name": "墨与纸 Ink and paper", "summary": "Paper ground, ink text, one seed accent used for marks and actions; dark ink bands for emphasis." },
    "C02": { "name": "克制单强调 Restrained accent", "summary": "Tinted neutrals do the work; the seed color appears only on actions, highlights, and the centerpiece." },
